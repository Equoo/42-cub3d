{
   MLX_mouse_hide
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libX11.so*
}
{
   Dynamic_Library_loading
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:_dl_open
}
{
   MLX_XOpenDisplay_err
   Memcheck:Param
   writev(vector[0])
   ...
   fun:mlx_int_wait_first_expose
}
{
   MLX_Breaking
   Memcheck:BreakingLeak
   ...
   fun:mlx*
}
